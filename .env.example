# App Configuration
APP_NAME=FX Signal Copier
DEBUG=false

# Gateway settings
GATEWAY_HOST=https://gateway.yourdomain.cloud
GATEWAY_PORT=443
GATEWAY_USE_SSL=true
GATEWAY_API_KEY_HEADER=X-API-Key
GATEWAY_CONNECT_TIMEOUT=10.0
GATEWAY_REQUEST_TIMEOUT=30.0
# Provider selection. Keep tonpo until MetaDocker is provisioned and verified.
ENGINE_PROVIDER=tonpo
METADOCKER_REQUEST_TIMEOUT=15.0
METADOCKER_MAX_TICK_AGE_SECONDS=10.0

# Telegram Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username
# HTTPS URL of the existing Web Mini App, configured in BotFather.
WEB_APP_URL=
TELEGRAM_WEBAPP_INIT_DATA_MAX_AGE_SECONDS=86400
# Optional explicit Telegram proxy. Empty means direct HTTPS without ambient proxy variables.
TELEGRAM_PROXY=
TELEGRAM_CONNECT_TIMEOUT=15
TELEGRAM_READ_TIMEOUT=15
TELEGRAM_WRITE_TIMEOUT=15
TELEGRAM_POOL_TIMEOUT=5

# Comma-separated Telegram user IDs
ADMIN_USER_IDS=[123456789,987654321]
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PORT=8443
ENABLE_WEBHOOKS=false
TRADINGVIEW_WEBHOOK_SECRET=
# Required target account for TradingView ingress; never send user_id in payloads.
TRADINGVIEW_TELEGRAM_ID=
# Explicit JSON mapping only; unknown symbols fail closed.
TRADINGVIEW_SYMBOL_MAP={}
TELEGRAM_SIGNAL_CHANNEL_IDS=
TRADINGVIEW_WEBHOOK_HOST=0.0.0.0
TRADINGVIEW_WEBHOOK_PORT=8080

# Database Configuration (use host `postgres` inside Docker Compose)
DATABASE_URL=postgresql://tonpo:change_me@localhost:5432/tonpo_bot
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Security
# Required: configure a valid Fernet key from a secret manager.
ENCRYPTION_KEY=
# Required: configure a random secret of at least 32 characters.
JWT_SECRET=
# Optional: separate admin API bootstrap key; never reuse JWT_SECRET here.
ADMIN_API_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Crypto Payments
USDT_WALLET_ADDRESS=0xYourERC20WalletHere
BTC_WALLET_ADDRESS=bc1YourBTCWalletHere
ETHERSCAN_API_KEY=YourFreeEtherscanKey
PAYMENT_EXPIRY_HOURS=2
PAYMENT_WEBHOOK_SECRET=
PAYMENT_REQUIRED_CONFIRMATIONS=12

# Trading Configuration
DEFAULT_RISK_FACTOR=0.01
MAX_RISK_FACTOR=0.05
MIN_RISK_FACTOR=0.001
DEFAULT_MAX_POSITION_SIZE=10.0
TRADING_DRY_RUN=true

# Rate Limiting
RATE_LIMIT_TRADES=5
RATE_LIMIT_CALCULATIONS=10
RATE_LIMIT_BALANCE=30
RATE_LIMIT_POSITIONS=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Web platform
# Explicit local development origins; set deployed frontend origins in deployment config.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Economic calendar protection. Enable only with a real configured calendar.
NEWS_PROTECTION_ENABLED=true
NEWS_PROVIDER_URL=
NEWS_PROVIDER_TIMEOUT_SECONDS=5
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_BASE_URL=https://api.tradingeconomics.com
TRADING_ECONOMICS_TIMEOUT_SECONDS=5
TRADING_ECONOMICS_CACHE_SECONDS=60
TRADING_ECONOMICS_STALE_AFTER_SECONDS=300
NEWS_PRE_WINDOW_MINUTES=30
NEWS_POST_WINDOW_MINUTES=30
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Docker Postgres (replace this sample before running Compose; never commit a real value)
POSTGRES_PASSWORD=change_me
# POSTGRES_USER=fxuser
# POSTGRES_DB=fx_signal_copier
