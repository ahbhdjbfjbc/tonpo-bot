# App Configuration
APP_NAME=FX Signal Copier
DEBUG=false

# Gateway settings
GATEWAY_HOST=https://gateway.yourdomain.cloud
GATEWAY_PORT=443
GATEWAY_USE_SSL=true
GATEWAY_API_KEY_HEADER=X-API-Key
GATEWAY_CONNECT_TIMEOUT=10.0
GATEWAY_REQUEST_TIMEOUT=30.0

# Telegram Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username

# Comma-separated Telegram user IDs
ADMIN_USER_IDS=[123456789,987654321]
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PORT=8443
ENABLE_WEBHOOKS=false
TRADINGVIEW_WEBHOOK_SECRET=
TELEGRAM_SIGNAL_CHANNEL_IDS=
TRADINGVIEW_WEBHOOK_HOST=0.0.0.0
TRADINGVIEW_WEBHOOK_PORT=8080

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/fx_signal_copier
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Security
ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here
JWT_SECRET=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Crypto Payments
USDT_WALLET_ADDRESS=0xYourERC20WalletHere
BTC_WALLET_ADDRESS=bc1YourBTCWalletHere
ETHERSCAN_API_KEY=YourFreeEtherscanKey
PAYMENT_EXPIRY_HOURS=2

# Trading Configuration
DEFAULT_RISK_FACTOR=0.01
MAX_RISK_FACTOR=0.05
MIN_RISK_FACTOR=0.001
DEFAULT_MAX_POSITION_SIZE=10.0
TRADING_DRY_RUN=true

# Rate Limiting
RATE_LIMIT_TRADES=5
RATE_LIMIT_CALCULATIONS=10
RATE_LIMIT_BALANCE=30
RATE_LIMIT_POSITIONS=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Web platform
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Docker Postgres (compose injects POSTGRES_PASSWORD from env — do not commit real values)
# POSTGRES_PASSWORD=
# POSTGRES_USER=fxuser
# POSTGRES_DB=fx_signal_copier

